# Keep the build context small and the build fast — none of this is needed
# inside the backend image.

frontend/
docs/
data/
.git/
.gitignore
.pytest_cache/
**/__pycache__/
**/*.pyc
.venv/
venv/
node_modules/

# Per-round event recordings are regenerable session logs, not source.
artifacts/events/

# Plots are generated by the offline training pipeline, not served live.
artifacts/**/*.png
