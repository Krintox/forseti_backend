# FORSETI configuration. Copy to .env and adjust as needed.

# Reproducibility. Changing the seed changes the generated data while keeping
# the pipeline deterministic for that seed.
SEED=42

# Where trained models and experiment artifacts are written/read.
# ARTIFACTS_DIR=./artifacts
# MODEL_PATH=./artifacts/models/forseti_model.joblib

# Licensed anchor datasets (PaySim / ULB). Not redistributed with this repo.
# Until present, the fidelity harness reports NOT RUN / DATASET UNAVAILABLE.
# DATASET_DIR=./data/anchors

# Post-quantum signing. ENABLE_PQC=0 forces the module to report
# "PQC MODULE UNAVAILABLE" instead of signing.
ENABLE_PQC=1
# Probe liboqs-python first (needs cmake + liboqs). Off by default because the
# import attempts a slow source build when the shared library is missing.
FORSETI_TRY_LIBOQS=0
# PQC_KEY_DIR=./private/pqc_keys

# Frontend -> backend endpoint.
NEXT_PUBLIC_API_BASE=http://localhost:8000
