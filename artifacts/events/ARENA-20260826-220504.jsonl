{"event_type": "DTL_EXPOSURE_UPDATED", "actor": "DTL", "payload": {"lifecycle": "hold -> authorized -> settled", "captured_total": 5000.0, "settled_now": 2750.0, "exposure_breakdown": {"settled": 2750.0, "authorized": 2250.0, "pending": 0.0, "reserved": 0.0, "total": 5000.0, "ceiling": 12000.0, "headroom": 7000.0}, "why_it_matters": "Settlement lags authorization. INV_01 counts settled + authorized + pending + reserved, because money that has not moved yet is still committed authority - and that lag is the window a cross-rail split exploits."}, "experiment_id": "ARENA-20260826-220504", "round_id": 16, "step": 0, "arrow_label": "SETTLEMENT SWEEP: Rs 2,750 SETTLED, Rs 2,250 STILL AUTHORIZED", "source": "dtl", "target": "exposure_meter", "severity": "info", "event_id": "evt_187591d48b16", "sequence": 109, "timestamp": "2026-08-26T22:05:05.329652+00:00", "monotonic_ms": 45055948.747, "offset_ms": 380.889, "prev_hash": "1c8cde7f4b5f49ad64655343c36909496b4daf5066090706b089217f559298f8", "entry_hash": "5fe57c99a533db5f1638719d66e6cf3b99fa7661deeaadcc7a1c8637b16189b1"}
