{"event_type": "DTL_EXPOSURE_UPDATED", "actor": "DTL", "payload": {"lifecycle": "hold -> authorized -> settled", "captured_total": 5000.0, "settled_now": 2750.0, "exposure_breakdown": {"settled": 2750.0, "authorized": 2250.0, "pending": 0.0, "reserved": 0.0, "total": 5000.0, "ceiling": 12000.0, "headroom": 7000.0}, "why_it_matters": "Settlement lags authorization. INV_01 counts settled + authorized + pending + reserved, because money that has not moved yet is still committed authority - and that lag is the window a cross-rail split exploits."}, "experiment_id": "ARENA-20260826-135723", "round_id": 16, "step": 0, "arrow_label": "SETTLEMENT SWEEP: Rs 2,750 SETTLED, Rs 2,250 STILL AUTHORIZED", "source": "dtl", "target": "exposure_meter", "severity": "info", "event_id": "evt_e855f91aa420", "sequence": 3553, "timestamp": "2026-08-26T13:57:24.112108+00:00", "monotonic_ms": 15796153.761, "offset_ms": 352.999, "prev_hash": "5723a76a5b3aa796de2a8f81099247f3238e73c4fbdef221b068f89f9a903c13", "entry_hash": "bac78d9231c0567e20a8902d7100071c309b6de154d72e9e736396aa79042de0"}
