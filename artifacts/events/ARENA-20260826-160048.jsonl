{"event_type": "DTL_EXPOSURE_UPDATED", "actor": "DTL", "payload": {"lifecycle": "hold -> authorized -> settled", "captured_total": 5000.0, "settled_now": 2750.0, "exposure_breakdown": {"settled": 2750.0, "authorized": 2250.0, "pending": 0.0, "reserved": 0.0, "total": 5000.0, "ceiling": 12000.0, "headroom": 7000.0}, "why_it_matters": "Settlement lags authorization. INV_01 counts settled + authorized + pending + reserved, because money that has not moved yet is still committed authority - and that lag is the window a cross-rail split exploits."}, "experiment_id": "ARENA-20260826-160048", "round_id": 16, "step": 0, "arrow_label": "SETTLEMENT SWEEP: Rs 2,750 SETTLED, Rs 2,250 STILL AUTHORIZED", "source": "dtl", "target": "exposure_meter", "severity": "info", "event_id": "evt_1aff1323543a", "sequence": 3494, "timestamp": "2026-08-26T16:00:48.796435+00:00", "monotonic_ms": 23200838.087, "offset_ms": 337.848, "prev_hash": "8855ef7ae7aad5a8e91e43eebaea2541f80cb3fdc1b97eb0c699dc7912bfff11", "entry_hash": "21e025330d10aa8369cbbbdbdccfcd15690c43f3e8afc11d2c7308ee57a7eb17"}
